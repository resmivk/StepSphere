<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Products | Stepsphere Admin</title>

  <!-- Bootstrap CSS -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css"
  />

  <!-- Font Awesome -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
  />

  <link rel="stylesheet" href="/style/admin/admin.css" />
</head>

<body>
  <div class="dashboard">
  

    <!-- Main Content -->
    <main class="main-content">
      
        

      <!-- Product Table Section -->
      <section class="content-area mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2>Product List</h2>
          <a href="/admin/add-product" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Product
          </a>
        </div>

        <div class="table-responsive">
          <table class="table table-striped table-bordered text-center align-middle">
            <thead class="thead-dark">
              <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Brand</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Category</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              {{#each products}}
              <tr>
                <td>
                  <img
                    src="/uploads/{{this.image}}"
                    alt="{{this.name}}"
                    width="80"
                    height="80"
                    class="rounded"
                  />
                </td>
                <td>{{this.name}}</td>
                <td>{{this.brand}}</td>
                <td>${{this.price}}</td>
                <td>{{this.stock}}</td>
                <td>{{this.category}}</td>
                <td>
                  <a href="/admin/edit-product/{{this._id}}" class="btn btn-sm btn-warning">
                    <i class="fas fa-edit"></i>
                  </a>
                  <a
                    href="/admin/delete-product/{{this._id}}"
                    class="btn btn-sm btn-danger"
                    onclick="return confirm('Are you sure you want to delete this product?')"
                  >
                    <i class="fas fa-trash-alt"></i>
                  </a>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
</body>
</html>
