
<div class="container mt-4">

  <!-- Title + Back Button -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Add New Product</h2>
    <a href="/admin/products" class="btn btn-secondary">
      <i class="fas fa-arrow-left"></i> Back to Products
    </a>
  </div>

  <!-- Error Message -->
  {{!-- {{#if error}}
    <div class="alert alert-danger alert-dismissible fade show">
       {{error}}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
  {{/if}} --}}
   {{#if message}}
    <div style="color: rgb(240, 5, 36); text-align: center; margin-bottom: 10px;">
      {{message}}
    </div>
    {{/if}}

  <form action="/admin/add-products" method="POST" enctype="multipart/form-data">
    <div class="table-responsive shadow-sm">
      <table class="table table-bordered text-center align-middle mb-0 bg-white">

        <!-- BASIC INFO -->
        <thead class="table-dark">
          <tr><th colspan="2">BASIC INFORMATION</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="text-start w-50">
              <label class="font-weight-bold mb-1">Product Name *</label>
              <input type="text" class="form-control" name="name"
                     placeholder="e.g. Air Max 270" required />
            </td>
            <td class="text-start w-50">
              <label class="font-weight-bold mb-1">Brand *</label>
              <input type="text" class="form-control" name="brand"
                     placeholder="e.g. Nike" required />
            </td>
          </tr>
          <tr>
            <td class="text-start">
              <label class="font-weight-bold mb-1">Price (₹) *</label>
              <input type="number" class="form-control" name="price"
                     placeholder="0" min="1" step="0.01" required />
            </td>
            <td class="text-start">
              <label class="font-weight-bold mb-1">Stock *</label>
              <input type="number" class="form-control" name="stock"
                     placeholder="0" min="0" value="1" required />
            </td>
          </tr>
        </tbody>

        <!-- CATEGORY -->
        <thead class="table-dark">
          <tr><th colspan="2">CATEGORY</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="text-start">
              <label class="font-weight-bold mb-1">Main Category *</label>
              <select class="form-control" name="category" id="mainCategory"
                      required onchange="filterSubcategories()">
                <option value="">— Select Main Category —</option>
                {{#each parents}}
                  <option value="{{this._id}}">{{this.name}}</option>
                {{/each}}
              </select>
            </td>
            <td class="text-start">
              <label class="font-weight-bold mb-1">
                Sub Category <small class="text-muted">(optional)</small>
              </label>
              <select class="form-control" name="subCategory" id="subCategory">
                <option value="">— Select Sub Category —</option>
                {{#each subcategories}}
                  <option value="{{this._id}}" data-parent="{{this.parent}}">
                    {{this.name}}
                  </option>
                {{/each}}
              </select>
            </td>
          </tr>
        </tbody>

        <!-- SIZES -->
        <thead class="table-dark">
          <tr><th colspan="2">AVAILABLE SIZES (UK)</th></tr>
        </thead>
        <tbody>
          <tr>
            <td colspan="2" class="text-start">
              <div class="d-flex flex-wrap gap-3 p-1">
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" name="size" value="6" id="s6" />
                  <label class="form-check-label font-weight-bold" for="s6">6</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" name="size" value="7" id="s7" />
                  <label class="form-check-label font-weight-bold" for="s7">7</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" name="size" value="8" id="s8" />
                  <label class="form-check-label font-weight-bold" for="s8">8</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" name="size" value="9" id="s9" />
                  <label class="form-check-label font-weight-bold" for="s9">9</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" name="size" value="10" id="s10" />
                  <label class="form-check-label font-weight-bold" for="s10">10</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="checkbox" name="size" value="11" id="s11" />
                  <label class="form-check-label font-weight-bold" for="s11">11</label>
                </div>
              </div>
            </td>
          </tr>
        </tbody>

        <!-- DESCRIPTION -->
        <thead class="table-dark">
          <tr><th colspan="2">DESCRIPTION</th></tr>
        </thead>
        <tbody>
          <tr>
            <td colspan="2" class="text-start">
              <textarea class="form-control" name="description" rows="3"
                        placeholder="Enter shoe details..."></textarea>
            </td>
          </tr>
        </tbody>

        <!-- IMAGES -->
        <thead class="table-dark">
          <tr><th colspan="2">PRODUCT IMAGES</th></tr>
        </thead>
        <tbody>
          <tr>
            <td colspan="2" class="text-start">
              <label class="font-weight-bold mb-1">
                Upload Images * <small class="text-muted">(max 5)</small>
              </label>
              <input type="file" class="form-control" name="images"
                     accept="image/*" multiple required
                     onchange="previewImages(this)" />
              <div class="d-flex flex-wrap gap-2 mt-2" id="imgPreview"></div>
            </td>
          </tr>
        </tbody>

        <!-- EXTRA -->
        <thead class="table-dark">
          <tr><th colspan="2">EXTRA</th></tr>
        </thead>
        <tbody>
          <tr>
            <td colspan="2" class="text-start">
              <div class="form-check">
                <input class="form-check-input" type="checkbox"
                       name="isBestSeller" id="isBestSeller" />
                <label class="form-check-label font-weight-bold" for="isBestSeller">
                  ⭐ Mark as Best Seller (shows on Home page)
                </label>
              </div>
            </td>
          </tr>
        </tbody>

        <!-- ACTIONS -->
        <thead class="table-dark">
          <tr><th colspan="2">ACTIONS</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="text-start">
              <a href="/admin/products" class="btn btn-danger px-4">
                <i class="fas fa-times"></i> Cancel
              </a>
            </td>
            <td class="text-end">
              <button type="submit" class="btn btn-primary px-4">
                <i class="fas fa-plus"></i> Add Product
              </button>
            </td>
          </tr>
        </tbody>

      </table>
    </div>
  </form>
</div>

<script>
  // Filter subcategories by selected parent
  function filterSubcategories() {
    const mainId = document.getElementById('mainCategory').value;
    const opts = document.querySelectorAll('#subCategory option[data-parent]');
    document.getElementById('subCategory').value = '';
    opts.forEach(opt => {
      opt.style.display = opt.getAttribute('data-parent') === mainId ? '' : 'none';
    });
  }

  // Preview selected images
  function previewImages(input) {
    const preview = document.getElementById('imgPreview');
    preview.innerHTML = '';
    Array.from(input.files).slice(0, 5).forEach(file => {
      const reader = new FileReader();
      reader.onload = e => {
        preview.innerHTML += `
          <img src="${e.target.result}"
               style="width:80px;height:80px;object-fit:cover;
                      border-radius:6px;border:1px solid #dee2e6;" />`;
      };
      reader.readAsDataURL(file);
    });
  }
</script>
