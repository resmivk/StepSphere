<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Offer Management - StepSphere Admin</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style/admin/admin.css">
</head>
<body>
  <div class="layout-container">
    {{> admin-Sidebar}}
    
    <div class="main-content">
      <div class="content p-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h2 class="font-weight-bold m-0"><i class="fas fa-percentage text-danger mr-2"></i>Offer Management</h2>
            <p class="text-muted small m-0">Set up promotional discounts for specific product categories or shoes.</p>
          </div>
          <button class="btn btn-danger font-weight-bold px-4" data-toggle="modal" data-target="#addOfferModal">
            <i class="fas fa-plus mr-2"></i>Create New Offer
          </button>
        </div>

        <!-- Offers Table Card -->
        <div class="card shadow-sm border-0 rounded-lg">
          <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
              <thead class="thead-light">
                <tr>
                  <th>CAMPAIGN TITLE</th>
                  <th>DISCOUNT</th>
                  <th>TARGET TYPE</th>
                  <th>TARGET NAME</th>
                  <th>END DATE</th>
                  <th>STATUS</th>
                  <th class="text-right">ACTIONS</th>
                </tr>
              </thead>
              <tbody>
                {{#if offers.length}}
                  {{#each offers}}
                    <tr>
                      <td class="font-weight-bold text-dark">{{this.title}}</td>
                      <td>
                        <span class="badge badge-success px-3 py-1 font-weight-bold" style="font-size: 0.9rem;">
                          {{this.discountPercentage}}% OFF
                        </span>
                      </td>
                      <td class="text-capitalize"><span class="badge badge-light border">{{this.targetType}}</span></td>
                      <td class="font-weight-600">
                        {{#if (eq this.targetType 'category')}}
                          {{this.targetCategory.name}}
                        {{else}}
                          {{this.targetProduct.name}}
                        {{/if}}
                      </td>
                      <td class="text-muted small">{{this.endDate}}</td>
                      <td>
                        {{#if this.isActive}}
                          <span class="badge badge-success px-3 py-1">Active</span>
                        {{else}}
                          <span class="badge badge-secondary px-3 py-1">Inactive</span>
                        {{/if}}
                      </td>
                      <td class="text-right">
                        <a href="/admin/offers/toggle/{{this._id}}" class="btn btn-sm {{#if this.isActive}}btn-outline-warning{{else}}btn-outline-success{{/if}} mr-1">
                          {{#if this.isActive}}Deactivate{{else}}Activate{{/if}}
                        </a>
                        <a href="/admin/offers/delete/{{this._id}}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this offer campaign?')">
                          <i class="fas fa-trash"></i>
                        </a>
                      </td>
                    </tr>
                  {{/each}}
                {{else}}
                  <tr>
                    <td colspan="7" class="text-center py-5 text-muted">
                      <i class="fas fa-percentage fa-3x mb-3 text-light"></i>
                      <h5>No Offers Found</h5>
                      <p class="small">Click "Create New Offer" above to set up category or product sales.</p>
                    </td>
                  </tr>
                {{/if}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Offer Modal -->
  <div class="modal fade" id="addOfferModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title font-weight-bold"><i class="fas fa-percentage text-danger mr-2"></i>Create New Offer</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <form id="offerForm">
          <div class="modal-body">
            <div class="form-group">
              <label class="font-weight-600 small">Offer Title</label>
              <input type="text" id="offerTitle" class="form-control" placeholder="e.g. Summer Running Shoes Offer" required />
            </div>

            <div class="form-row">
              <div class="form-group col-md-6">
                <label class="font-weight-600 small">Discount (%)</label>
                <input type="number" id="offerDiscount" class="form-control" placeholder="20" min="1" max="99" required />
              </div>
              <div class="form-group col-md-6">
                <label class="font-weight-600 small">Target Type</label>
                <select id="targetType" class="form-control" onchange="toggleTargetDropdowns()" required>
                  <option value="category">Category Offer</option>
                  <option value="product">Product Offer</option>
                </select>
              </div>
            </div>

            <!-- Target Category Selector -->
            <div class="form-group" id="categoryGroup">
              <label class="font-weight-600 small">Select Category</label>
              <select id="targetCategory" class="form-control">
                {{#each categories}}
                  <option value="{{this._id}}">{{this.name}}</option>
                {{/each}}
              </select>
            </div>

            <!-- Target Product Selector -->
            <div class="form-group d-none" id="productGroup">
              <label class="font-weight-600 small">Select Product</label>
              <select id="targetProduct" class="form-control">
                {{#each products}}
                  <option value="{{this._id}}">{{this.name}} (₹{{this.price}})</option>
                {{/each}}
              </select>
            </div>

            <div class="form-row">
              <div class="form-group col-md-6">
                <label class="font-weight-600 small">Start Date</label>
                <input type="date" id="startDate" class="form-control" />
              </div>
              <div class="form-group col-md-6">
                <label class="font-weight-600 small">End Date</label>
                <input type="date" id="endDate" class="form-control" required />
              </div>
            </div>
          </div>

          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-light font-weight-600" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-danger font-weight-bold px-4" onclick="submitOffer()">Save Offer</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function toggleTargetDropdowns() {
      const type = document.getElementById('targetType').value;
      if (type === 'category') {
        document.getElementById('categoryGroup').classList.remove('d-none');
        document.getElementById('productGroup').classList.add('d-none');
      } else {
        document.getElementById('categoryGroup').classList.add('d-none');
        document.getElementById('productGroup').classList.remove('d-none');
      }
    }

    async function submitOffer() {
      const title = document.getElementById('offerTitle').value;
      const discountPercentage = document.getElementById('offerDiscount').value;
      const targetType = document.getElementById('targetType').value;
      const targetCategory = document.getElementById('targetCategory').value;
      const targetProduct = document.getElementById('targetProduct').value;
      const startDate = document.getElementById('startDate').value;
      const endDate = document.getElementById('endDate').value;

      if (!title || !discountPercentage || !endDate) {
        alert('Please fill out all required fields.');
        return;
      }

      try {
        const res = await fetch('/admin/offers/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, discountPercentage, targetType, targetCategory, targetProduct, startDate, endDate })
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message);
          window.location.reload();
        } else {
          alert(data.message || 'Failed to create offer');
        }
      } catch (err) {
        console.error(err);
        alert('Error creating offer.');
      }
    }
  </script>
</body>
</html>
