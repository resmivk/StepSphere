<div class="container mt-4">

  <!-- Title + Back Button -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Add New Category</h2>
    <a href="/admin/categories/category" class="btn btn-secondary">
      <i class="fas fa-arrow-left"></i> Back to Categories
    </a>
  </div>

  <!-- Error Message -->
  {{#if message}}
    <div class="alert alert-danger alert-dismissible fade show">
      ⚠️ {{message}}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
  {{/if}}

  <!-- Form -->
  <div class="shadow-sm rounded bg-white p-4" style="max-width: 600px;">
    <form action="/admin/categories/addcategory" method="POST">

      <!-- Category Name -->
      <div class="form-group">
        <label class="font-weight-bold">Category Name *</label>
        <input type="text" class="form-control" name="name"
               placeholder="e.g. Men, Sneakers, Running"
               value="{{formData.name}}" required />
      </div>

      <!-- Parent Category -->
      <div class="form-group">
        <label class="font-weight-bold">Parent Category
          <small class="text-muted font-weight-normal">(leave empty for main category)</small>
        </label>
        <select class="form-control" name="parent">
          <option value="">— No Parent (Main Category) —</option>
          {{#each parents}}
            <option value="{{this._id}}"
              {{#if (eq this._id ../formData.parent)}}selected{{/if}}>
              {{this.name}}
            </option>
          {{/each}}
        </select>
      </div>

      <!-- Description -->
      <div class="form-group">
        <label class="font-weight-bold">Description
          <small class="text-muted font-weight-normal">(optional)</small>
        </label>
        <textarea class="form-control" name="description" rows="3"
                  placeholder="Brief description of this category...">{{formData.description}}</textarea>
      </div>

      <!-- Actions -->
      <div class="d-flex justify-content-between mt-4">
        <a href="/admin/categories/category" class="btn btn-danger px-4">Cancel</a>
        <button type="submit" class="btn btn-primary px-4">
          <i class="fas fa-plus"></i> Add Category
        </button>
      </div>

    </form>
  </div>

</div>
