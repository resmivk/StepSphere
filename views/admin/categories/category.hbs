<div class="container mt-4">

  <!-- Title + Add Button -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">Category Management</h2>
    <a href="/admin/categories/addcategory" class="btn btn-primary">
      <i class="fas fa-plus"></i> Add New Category
    </a>
  </div>

  <!-- Success Message -->
  {{#if successMessage}}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      ✅ {{successMessage}}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
  {{/if}}

  <!-- Search Bar -->
  <form method="GET" action="/admin/categories/category" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
      <input type="text" name="search" class="form-control"
             placeholder="Search categories..."
             value="{{search}}" />
      <div class="input-group-append">
        <button class="btn btn-primary" type="submit">
          <i class="fas fa-search"></i> Search
        </button>
        {{#if search}}
          <a href="/admin/categories/category" class="btn btn-outline-secondary">
            <i class="fas fa-times"></i> Clear
          </a>
        {{/if}}
      </div>
    </div>
  </form>

  <!-- Table -->
  <div class="table-responsive shadow-sm">
    <table class="table table-striped table-bordered text-center align-middle">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Name</th>
          <th>Parent Category</th>
          <th>Description</th>
          <th>Products</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each categories}}
        <tr>
          <td>{{addOne @index}}</td>
          <td class="font-weight-bold">{{this.name}}</td>
          <td>
            {{#if this.parent}}
              <span class="badge badge-info">{{this.parent.name}}</span>
            {{else}}
              <span class="text-muted">— Main Category</span>
            {{/if}}
          </td>
          <td>
            {{#if this.description}}
              {{this.description}}
            {{else}}
              <span class="text-muted">—</span>
            {{/if}}
          </td>
          <td>
            <span class="badge badge-secondary">{{this.productCount}} products</span>
          </td>
          <td>
            {{#if this.isActive}}
              <span class="badge badge-success px-3 py-2">Active</span>
            {{else}}
              <span class="badge badge-danger px-3 py-2">Inactive</span>
            {{/if}}
          </td>
          <td>
            <!-- Edit -->
            <a href="/admin/categories/editCategory/{{this._id}}"
               class="btn btn-sm btn-warning mr-1">
              <i class="fas fa-edit"></i> Edit
            </a>

            <!-- Toggle -->
            <a href="/admin/categories/toggle/{{this._id}}"
               class="btn btn-sm {{#if this.isActive}}btn-secondary{{else}}btn-success{{/if}} mr-1"
               onclick="return confirm('{{#if this.isActive}}Deactivate{{else}}Activate{{/if}} {{this.name}}?')">
              {{#if this.isActive}}
                <i class="fas fa-eye-slash"></i> Deactivate
              {{else}}
                <i class="fas fa-eye"></i> Activate
              {{/if}}
            </a>

            <!-- Delete -->
            <a href="/admin/categories/deleteCategory/{{this._id}}"
               class="btn btn-sm btn-danger"
               onclick="return confirm('Permanently delete {{this.name}}? This cannot be undone!')">
              <i class="fas fa-trash-alt"></i> Delete
            </a>
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="7" class="text-center text-muted py-4">
            {{#if search}}
              No categories found for "<strong>{{search}}</strong>"
            {{else}}
              No categories added yet.
            {{/if}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <!-- Total Count -->
  <p class="text-muted mt-2 small">Total: {{categories.length}} category(ies)</p>

</div>
