<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Coupon Management - StepSphere Admin</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/style/admin/admin.css">
</head>
<body>
  <div class="layout-container">
   
    
    <div class="main-content">
      <div class="content p-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h2 class="font-weight-bold m-0"><i class="fas fa-ticket-alt text-primary mr-2"></i>Coupon Management</h2>
            <p class="text-muted small m-0">Create and manage promotional discount coupons for store checkout.</p>
          </div>
          <button class="btn btn-primary font-weight-bold px-4" data-toggle="modal" data-target="#addCouponModal">
            <i class="fas fa-plus mr-2"></i>Create New Coupon
          </button>
        </div>

        <!-- Coupons Table Card -->
        <div class="card shadow-sm border-0 rounded-lg">
          <div class="table-responsive">
            <table class="table table-hover align-middle m-0">
              <thead class="thead-light">
                <tr>
                  <th>CODE</th>
                  <th>DISCOUNT</th>
                  <th>MIN PURCHASE</th>
                  <th>MAX DISCOUNT</th>
                  <th>USAGE</th>
                  <th>EXPIRY</th>
                  <th>STATUS</th>
                  <th class="text-right">ACTIONS</th>
                </tr>
              </thead>
              <tbody>
                {{#if coupons.length}}
                  {{#each coupons}}
                    <tr>
                      <td>
                        <span class="badge badge-dark px-3 py-2 font-mono font-weight-bold text-uppercase" style="letter-spacing:1px; font-size: 0.9rem;">
                          {{this.code}}
                        </span>
                      </td>
                      <td class="font-weight-bold text-success">
                        {{#if (eq this.discountType 'percentage')}}
                          {{this.discountValue}}% OFF
                        {{else}}
                          ₹{{this.discountValue}} OFF
                        {{/if}}
                      </td>
                      <td>₹{{this.minPurchase}}</td>
                      <td>{{#if this.maxDiscount}}₹{{this.maxDiscount}}{{else}}N/A{{/if}}</td>
                      <td>{{this.usedCount}} / {{this.usageLimit}}</td>
                      <td class="text-muted small">{{this.expiryDate}}</td>
                      <td>
                        {{#if this.isActive}}
                          <span class="badge badge-success px-3 py-1">Active</span>
                        {{else}}
                          <span class="badge badge-secondary px-3 py-1">Inactive</span>
                        {{/if}}
                      </td>
                      <td class="text-right">
                        <a href="/admin/coupons/toggle/{{this._id}}" class="btn btn-sm {{#if this.isActive}}btn-outline-warning{{else}}btn-outline-success{{/if}} mr-1">
                          {{#if this.isActive}}Deactivate{{else}}Activate{{/if}}
                        </a>
                        <a href="/admin/coupons/delete/{{this._id}}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this coupon code?')">
                          <i class="fas fa-trash"></i>
                        </a>
                      </td>
                    </tr>
                  {{/each}}
                {{else}}
                  <tr>
                    <td colspan="8" class="text-center py-5 text-muted">
                      <i class="fas fa-ticket-alt fa-3x mb-3 text-light"></i>
                      <h5>No Coupons Found</h5>
                      <p class="small">Click "Create New Coupon" above to add your first promotional code.</p>
                    </td>
                  </tr>
                {{/if}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Coupon Modal -->
  <div class="modal fade" id="addCouponModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title font-weight-bold"><i class="fas fa-tag text-primary mr-2"></i>Create New Coupon</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <form id="couponForm">
          <div class="modal-body">
            <div class="form-group">
              <label class="font-weight-600 small">Coupon Code</label>
              <input type="text" id="couponCode" class="form-control text-uppercase font-weight-bold" placeholder="e.g. STEP100" required />
            </div>

            <div class="form-row">
              <div class="form-group col-md-6">
                <label class="font-weight-600 small">Discount Type</label>
                <select id="discountType" class="form-control" required>
                  <option value="percentage">Percentage (%)</option>
                  <option value="flat">Flat Amount (₹)</option>
                </select>
              </div>
              <div class="form-group col-md-6">
                <label class="font-weight-600 small">Discount Value</label>
                <input type="number" id="discountValue" class="form-control" placeholder="10 or 100" min="1" required />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group col-md-6">
                <label class="font-weight-600 small">Min Purchase (₹)</label>
                <input type="number" id="minPurchase" class="form-control" placeholder="500" value="0" />
              </div>
              <div class="form-group col-md-6">
                <label class="font-weight-600 small">Max Discount Cap (₹)</label>
                <input type="number" id="maxDiscount" class="form-control" placeholder="Optional for %" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group col-md-6">
                <label class="font-weight-600 small">Expiry Date</label>
                <input type="date" id="expiryDate" class="form-control" required />
              </div>
              <div class="form-group col-md-6">
                <label class="font-weight-600 small">Usage Limit</label>
                <input type="number" id="usageLimit" class="form-control" value="100" required />
              </div>
            </div>
          </div>

          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-light font-weight-600" data-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary font-weight-bold px-4" onclick="submitCoupon()">Save Coupon</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    async function submitCoupon() {
      const code = document.getElementById('couponCode').value;
      const discountType = document.getElementById('discountType').value;
      const discountValue = document.getElementById('discountValue').value;
      const minPurchase = document.getElementById('minPurchase').value;
      const maxDiscount = document.getElementById('maxDiscount').value;
      const expiryDate = document.getElementById('expiryDate').value;
      const usageLimit = document.getElementById('usageLimit').value;

      if (!code || !discountValue || !expiryDate) {
        alert('Please fill out all required fields.');
        return;
      }

      try {
        const res = await fetch('/admin/coupons/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code, discountType, discountValue, minPurchase, maxDiscount, expiryDate, usageLimit })
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message);
          window.location.reload();
        } else {
          alert(data.message || 'Failed to add coupon');
        }
      } catch (err) {
        console.error(err);
        alert('Error creating coupon.');
      }
    }
  </script>
</body>
</html>
