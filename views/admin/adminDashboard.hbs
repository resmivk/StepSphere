<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StepSphere Admin Dashboard</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="/style/admin/admin.css">
</head>
<body>
    <div class="layout-container">
        <!-- Main Content -->
        <div class="main-content">
            <!-- Page Content -->
            <div class="content">
                <!-- Page Header -->
                <div class="page-header">
                    <div>
                        <h1 class="page-title">Admin Dashboard</h1>
                        <div class="breadcrumb">
                            <a href="/admin/admindashboard">Home</a>
                            <i class="fas fa-chevron-right"></i>
                            <span>Overview</span>
                        </div>
                    </div>
                </div>

                <!-- Stats Cards Grid -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-header">
                            <h3 class="stat-title">Total Revenue</h3>
                            <div class="stat-icon primary">
                                <i class="fas fa-rupee-sign"></i>
                            </div>
                        </div>
                        <div class="stat-value">₹{{totalRevenue}}</div>
                        <div class="stat-change positive">
                            <i class="fas fa-chart-line"></i> Valid Sales
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-header">
                            <h3 class="stat-title">Total Orders</h3>
                            <div class="stat-icon success">
                                <i class="fas fa-shopping-bag"></i>
                            </div>
                        </div>
                        <div class="stat-value">{{totalOrders}}</div>
                        <div class="stat-change positive">
                            <i class="fas fa-box"></i> Live Orders
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-header">
                            <h3 class="stat-title">Customers</h3>
                            <div class="stat-icon warning">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="stat-value">{{totalCustomers}}</div>
                        <div class="stat-change positive">
                            <i class="fas fa-user-check"></i> Registered Users
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-header">
                            <h3 class="stat-title">Catalog Products</h3>
                            <div class="stat-icon danger">
                                <i class="fas fa-shoe-prints"></i>
                            </div>
                        </div>
                        <div class="stat-value">{{totalProducts}}</div>
                        <div class="stat-change positive">
                            <i class="fas fa-tags"></i> Active Items
                        </div>
                    </div>
                </div>

                <!-- Charts Section (Graphical Representations) -->
                <div class="row my-4">
                    <!-- Sales & Revenue Trend Chart -->
                    <div class="col-lg-8 mb-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-white border-0 py-3">
                                <h5 class="card-title m-0 font-weight-bold text-dark">
                                    <i class="fas fa-chart-area text-primary mr-2"></i> Revenue & Sales Trend
                                </h5>
                            </div>
                            <div class="card-body">
                                <canvas id="revenueChart" height="220"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Order Status Distribution Chart -->
                    <div class="col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-white border-0 py-3">
                                <h5 class="card-title m-0 font-weight-bold text-dark">
                                    <i class="fas fa-chart-pie text-success mr-2"></i> Order Statuses
                                </h5>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center">
                                <canvas id="statusChart" height="220"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Orders Table -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                        <h5 class="card-title m-0 font-weight-bold text-dark">
                            <i class="fas fa-list text-info mr-2"></i> Recent Customer Orders
                        </h5>
                        <a href="/admin/orders" class="btn btn-sm btn-outline-primary">View All Orders</a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle m-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>ORDER ID</th>
                                    <th>CUSTOMER</th>
                                    <th>AMOUNT</th>
                                    <th>STATUS</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#if recentOrders.length}}
                                    {{#each recentOrders}}
                                        <tr>
                                            <td class="font-weight-bold">#{{this._id}}</td>
                                            <td>
                                                <div class="customer-name font-weight-600">{{this.user.name}}</div>
                                                <small class="text-muted">{{this.user.email}}</small>
                                            </td>
                                            <td class="font-weight-bold text-primary">₹{{this.totalAmount}}</td>
                                            <td>
                                                <span class="badge badge-pill 
                                                    {{#if (eq this.orderStatus 'placed')}}badge-primary{{/if}}
                                                    {{#if (eq this.orderStatus 'processing')}}badge-warning{{/if}}
                                                    {{#if (eq this.orderStatus 'shipped')}}badge-info{{/if}}
                                                    {{#if (eq this.orderStatus 'delivered')}}badge-success{{/if}}
                                                    {{#if (eq this.orderStatus 'cancelled')}}badge-danger{{/if}}
                                                    px-3 py-2">
                                                    {{this.orderStatus}}
                                                </span>
                                            </td>
                                        </tr>
                                    {{/each}}
                                {{else}}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No recent orders found.</td>
                                    </tr>
                                {{/if}}
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Chart Initialization Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Revenue Line/Bar Chart
            const revenueCtx = document.getElementById('revenueChart').getContext('2d');
            const chartLabels = {{{chartLabelsJson}}};
            const chartRevenue = {{{chartRevenueJson}}};

            new Chart(revenueCtx, {
                type: 'bar',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        label: 'Monthly Revenue (₹)',
                        data: chartRevenue,
                        backgroundColor: 'rgba(37, 99, 235, 0.75)',
                        borderColor: '#2563eb',
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#e2e8f0' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });

            // Order Status Doughnut Chart
            const statusCtx = document.getElementById('statusChart').getContext('2d');
            const statusCounts = {{{statusCountsJson}}};

            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Placed', 'Processing', 'Shipped', 'Delivered', 'Cancelled'],
                    datasets: [{
                        data: statusCounts,
                        backgroundColor: [
                            '#2563eb', // Placed - Blue
                            '#f59e0b', // Processing - Orange
                            '#06b6d4', // Shipped - Cyan
                            '#10b981', // Delivered - Green
                            '#ef4444'  // Cancelled - Red
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        });
    </script>
</body>
</html>