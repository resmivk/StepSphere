 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stepsphere Admin</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Rokkitt:wght@100;300;400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/style/admin/admin.css">
</head>
<body>
   <body>
    <div class="layout-container">
        <!-- Sidebar -->
       

        <!-- Main Content -->
        <div class="main-content">
           

            <!-- Page Content -->
            <div class="content">
                <!-- Page Header -->
                <div class="page-header">
                    <div>
                        <h1 class="page-title">Dashboard</h1>
                        <div class="breadcrumb">
                            <a href="#">Home</a>
                            <i class="fas fa-chevron-right"></i>
                            <span>Dashboard</span>
                        </div>
                    </div>
                    <div class="card-actions">
                        <button class="btn btn-primary">New Order</button>
                    </div>
                </div>

                <!-- Stats Cards -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-header">
                            <h3 class="stat-title">Total Revenue</h3>
                            <div class="stat-icon primary">
                                <i class="fas fa-dollar-sign"></i>
                            </div>
                        </div>
                        <div class="stat-value">$12,426</div>
                        <div class="stat-change positive">
                            <i class="fas fa-arrow-up"></i>
                            12.5% from last month
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-header">
                            <h3 class="stat-title">Orders</h3>
                            <div class="stat-icon success">
                                <i class="fas fa-shopping-cart"></i>
                            </div>
                        </div>
                        <div class="stat-value">1,258</div>
                        <div class="stat-change positive">
                            <i class="fas fa-arrow-up"></i>
                            8.2% from last month
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-header">
                            <h3 class="stat-title">Customers</h3>
                            <div class="stat-icon warning">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="stat-value">4,872</div>
                        <div class="stat-change positive">
                            <i class="fas fa-arrow-up"></i>
                            5.7% from last month
                        </div>
                    </div>
                    
                    <div class="stat-card">
                        <div class="stat-header">
                            <h3 class="stat-title">Products</h3>
                            <div class="stat-icon danger">
                                <i class="fas fa-box"></i>
                            </div>
                        </div>
                        <div class="stat-value">156</div>
                        <div class="stat-change negative">
                            <i class="fas fa-arrow-down"></i>
                            2.1% from last month
                        </div>
                    </div>
                </div>

                <!-- Main Content Grid -->
                <div class="content-grid">
                    <!-- Recent Orders Card -->
                    <div class="card">
                        <div class="card-header">
                            <h2 class="card-title">Recent Orders</h2>
                            <div class="card-actions">
                                <button class="btn btn-outline">View All</button>
                            </div>
                        </div>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>ORDER ID</th>
                                    <th>CUSTOMER</th>
                                    <th>DATE</th>
                                    <th>AMOUNT</th>
                                    <th>STATUS</th>
                                    <th>ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="order-id">#SK-2548</td>
                                    <td class="customer">
                                        <div class="customer-name">Amanda Smith</div>
                                    </td>
                                    <td>Jun 15, 2023</td>
                                    <td>$245.00</td>
                                    <td><span class="status completed">Completed</span></td>
                                    <td><i class="fas fa-ellipsis-v"></i></td>
                                </tr>
                                <tr>
                                    <td class="order-id">#SK-2547</td>
                                    <td class="customer">
                                        <div class="customer-name">Robert Johnson</div>
                                    </td>
                                    <td>Jun 14, 2023</td>
                                    <td>$189.50</td>
                                    <td><span class="status pending">Pending</span></td>
                                    <td><i class="fas fa-ellipsis-v"></i></td>
                                </tr>
                                <tr>
                                    <td class="order-id">#SK-2546</td>
                                    <td class="customer">
                                        <div class="customer-name">Sarah Williams</div>
                                    </td>
                                    <td>Jun 13, 2023</td>
                                    <td>$320.75</td>
                                    <td><span class="status processing">Processing</span></td>
                                    <td><i class="fas fa-ellipsis-v"></i></td>
                                </tr>
                                <tr>
                                    <td class="order-id">#SK-2545</td>
                                    <td class="customer">
                                        <div class="customer-name">Michael Brown</div>
                                    </td>
                                    <td>Jun 12, 2023</td>
                                    <td>$175.25</td>
                                    <td><span class="status completed">Completed</span></td>
                                    <td><i class="fas fa-ellipsis-v"></i></td>
                                </tr>
                                <tr>
                                    <td class="order-id">#SK-2544</td>
                                    <td class="customer">
                                        <div class="customer-name">Emily Davis</div>
                                    </td>
                                    <td>Jun 11, 2023</td>
                                    <td>$420.00</td>
                                    <td><span class="status cancelled">Cancelled</span></td>
                                    <td><i class="fas fa-ellipsis-v"></i></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Recent Activity Card -->
                    <div class="card">
                        <div class="card-header">
                            <h2 class="card-title">Recent Activity</h2>
                        </div>
                        <div class="timeline">
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="timeline-content">
                                    <h4 class="timeline-title">New order received</h4>
                                    <div class="timeline-time">2 min ago</div>
                                    <p class="timeline-description">Order #SK-2549 from John Doe</p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="timeline-content">
                                    <h4 class="timeline-title">Payment received</h4>
                                    <div class="timeline-time">15 min ago</div>
                                    <p class="timeline-description">$245.00 from Amanda Smith</p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="timeline-content">
                                    <h4 class="timeline-title">New product added</h4>
                                    <div class="timeline-time">1 hour ago</div>
                                    <p class="timeline-description">Nike Air Force 1 by admin</p>
                                </div>
                            </div>
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="timeline-content">
                                    <h4 class="timeline-title">Order shipped</h4>
                                    <div class="timeline-time">3 hours ago</div>
                                    <p class="timeline-description">Order #SK-2545 to Michael Brown</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>