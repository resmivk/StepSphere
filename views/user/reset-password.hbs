<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
    <style>
        /* Consistent with previous styles */
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f8f9fa;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            background-color: #ffffff;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            width: 450px;
            max-width: 90%;
        }

        h1 {
            text-align: center;
            color: #343a40;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #495057;
        }

        input[type="email"],
        input[type="password"] {
            width: calc(100% - 16px);
            padding: 12px;
            border: 1px solid #ced4da;
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 16px;
            color: #495057;
        }

        input:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        }

        .error-message {
            color: #dc3545;
            font-size: 0.9em;
            margin-top: 5px;
        }

        .submit-button {
            background-color:  #007bff;
            color: white;
            padding: 14px 24px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 18px;
            width: 100%;
            transition: background-color 0.2s ease-in-out;
        }

        .submit-button:hover {
            background-color: #007bff;
        }

        .login-link {
            text-align: center;
            margin-top: 25px;
            font-size: 0.95em;
            color: #6c757d;
        }

        .login-link a {
            color: #007bff;
            text-decoration: none;
            font-weight: 500;
        }

        .login-link a:hover {
            text-decoration: underline;
        }

        .instructions {
            color: #6c757d;
            margin-bottom: 25px;
            line-height: 1.6;
        }
    </style>
</head>
<body>
    <!-- Password Reset Request Page -->
    <div class="container" id="resetRequest">
        <h1>Reset Your Password</h1>
        <p class="instructions">Enter your email address and we'll send you a link to reset your password.</p>
        
        <form id="resetRequestForm" onsubmit="return handleResetRequest(event)">
            <div class="form-group">
                <label for="resetEmail">Email Address</label>
                <input 
                type="email" 
                name="email"
                id="resetEmail"
                 required>
                <span class="error-message" id="emailError"></span>
            </div>
            
            <button type="submit" class="submit-button">Send Reset Link</button>
        </form>
        
        <div class="login-link">
            Remember your password? <a href="/login">Login here</a>
        </div>
    </div>

    <!-- Password Reset Form (hidden by default) -->
    <div class="container" id="resetForm" style="display: none;">
        <h1>Create New Password</h1>
        <p class="instructions">Your new password must be different from previously used passwords.</p>
        
        <form  action="/reset-password" method="post"id="passwordResetForm" onsubmit="return handlePasswordReset(event)">
            <div class="form-group">
                <label for="newPassword">New Password</label>
                <input type="password" 
                id="newPassword" 
                required>
                <span class="error-message" id="passwordError"></span>
            </div>
            
            <div class="form-group">
                <label for="confirmPassword">Confirm Password</label>
                <input type="password" 
                name="password"
                id="confirmPassword" 
                class=""
                required>
                <span class="error-message" id="confirmError"></span>
            </div>
            
            <button type="submit" class="submit-button">Reset Password</button>
        </form>
        
        <div class="login-link">
            <a href="/login">Back to Login</a>
        </div>
    </div>

    <script>
        // Simulate email sending and token verification
        let resetToken = null;

        function handleResetRequest(event) {
            event.preventDefault();
            const email = document.getElementById('resetEmail').value.trim();
            const errorElement = document.getElementById('emailError');

            // Reset error
            errorElement.textContent = '';

            // Simple email validation
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                errorElement.textContent = 'Please enter a valid email address';
                return false;
            }

            // Simulate API call
            setTimeout(() => {
                // Show success message
                alert('Reset link sent to your email!');
                
                // Simulate token generation
                resetToken = 'simulated-token-12345';
                
                // Switch to password reset form
                document.getElementById('resetRequest').style.display = 'none';
                document.getElementById('resetForm').style.display = 'block';
            }, 500);

            return false;
        }

        function handlePasswordReset(event) {
            event.preventDefault();
            const password = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const passwordError = document.getElementById('passwordError');
            const confirmError = document.getElementById('confirmError');

            // Reset errors
            passwordError.textContent = '';
            confirmError.textContent = '';

            let isValid = true;

            // Password validation
            if (password.length < 8) {
                passwordError.textContent = 'Password must be at least 8 characters';
                isValid = false;
            }

            if (password !== confirmPassword) {
                confirmError.textContent = 'Passwords do not match';
                isValid = false;
            }

            if (isValid && resetToken) {
                // Simulate API call
                setTimeout(() => {
                    alert('Password reset successfully!');
                    window.location.href = '/login'; // Redirect to login
                }, 500);
            }

            return false;
        }
    </script>
</body>
</html>