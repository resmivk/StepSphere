
<style>
  body { font-family: 'Rokkitt', serif; background-color: #f8f9fa; }
  h1,h2,h3,h4,h5,h6 { font-family: 'Montserrat', sans-serif; }

  /* ── HERO ── */
  .category-hero {
    height: 480px;
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
                url('https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1600&q=80')
                center/cover no-repeat;
    display: flex; align-items: center; justify-content: center;
    color: white; text-align: center; margin-bottom: 0;
  }
  .category-hero h1 {
    font-size: 4rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 4px;
    text-shadow: 2px 2px 8px rgba(0,0,0,0.5);
    margin-bottom: 12px;
  }
  .category-hero p {
    font-size: 1.2rem; margin-bottom: 24px; opacity: 0.9;
  }

  /* ── SECTION TITLE ── */
  .section-title {
    position: relative; margin-bottom: 40px;
    font-weight: 700; text-align: center;
  }
  .section-title:after {
    content: ''; position: absolute;
    bottom: -12px; left: 50%; transform: translateX(-50%);
    width: 80px; height: 3px; background-color: #17a2b8;
  }

  /* ── FILTER BAR ── */
  .filter-bar {
    background: white; padding: 16px 24px;
    border-bottom: 1px solid #eee;
    display: flex; align-items: center;
    justify-content: space-between; flex-wrap: wrap; gap: 12px;
    margin-bottom: 30px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }
  .filter-bar .result-count {
    font-size: 14px; color: #6c757d; font-weight: 600;
  }
  .filter-bar .sort-select {
    border: 1px solid #dee2e6; border-radius: 6px;
    padding: 6px 12px; font-size: 14px; color: #333;
    outline: none; cursor: pointer;
  }

  /* ── SIDEBAR ── */
  .sidebar-card {
    background: white; border-radius: 10px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    padding: 20px; margin-bottom: 20px;
  }
  .sidebar-card h5 {
    font-size: 13px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 1px;
    color: #6c757d; margin-bottom: 14px;
    padding-bottom: 10px; border-bottom: 1px solid #f0f0f0;
  }
  .sidebar-card a {
    display: block; padding: 8px 0;
    color: #333; text-decoration: none; font-size: 14px;
    border-bottom: 1px solid #f8f8f8;
    transition: color 0.2s; font-weight: 500;
  }
  .sidebar-card a:hover { color: #17a2b8; }
  .sidebar-card a.active { color: #17a2b8; font-weight: 700; }

  /* Price range */
  .price-range { display: flex; gap: 8px; align-items: center; }
  .price-range input {
    border: 1px solid #dee2e6; border-radius: 6px;
    padding: 6px 10px; font-size: 13px; width: 80px;
  }

  /* ── PRODUCT CARDS ── */
  .product-card {
    border: none; border-radius: 10px;
    overflow: hidden; transition: transform 0.3s;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    margin-bottom: 24px; background: white;
  }
  .product-card:hover { transform: translateY(-8px); box-shadow: 0 12px 28px rgba(0,0,0,0.15); }
  .product-img-wrap { overflow: hidden; height: 220px; background: #f5f5f5; }
  .product-img {
    width: 100%; height: 220px; object-fit: cover;
    transition: transform 0.5s;
  }
  .product-card:hover .product-img { transform: scale(1.08); }
  .product-card .card-body { padding: 16px; }
  .product-card .card-title { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
  .product-brand { font-size: 12px; color: #17a2b8; font-weight: 600; text-transform: uppercase; }
  .product-price { font-size: 18px; font-weight: 700; color: #1a1a2e; margin: 8px 0; }

  .btn-primary {
    background-color: #17a2b8; border-color: #17a2b8;
    border-radius: 30px; font-weight: 600; transition: all 0.3s;
  }
  .btn-primary:hover { background-color: #138496; border-color: #138496; transform: translateY(-2px); }
  .btn-outline-primary { border-color: #17a2b8; color: #17a2b8; border-radius: 30px; }
  .btn-outline-primary:hover { background-color: #17a2b8; color: white; }

  /* ── EMPTY STATE ── */
  .empty-state { text-align: center; padding: 60px 20px; }
  .empty-state i { font-size: 64px; color: #dee2e6; margin-bottom: 16px; }
  .empty-state h4 { color: #6c757d; font-size: 20px; }

  @media (max-width: 767px) {
    .category-hero { height: 320px; }
    .category-hero h1 { font-size: 2.5rem; }
  }
</style>

<!-- ── HERO ── -->
<div class="category-hero">
  <div>
    <h1>Men's Collection</h1>
    <p>Elevate your style with our premium selection.</p>
    <a href="/products" class="btn btn-primary px-4">Shop All</a>
  </div>
</div>

<!-- ── FILTER BAR ── -->
<div class="filter-bar">
  <span class="result-count">Showing {{products.length}} results</span>
  <select class="sort-select" onchange="sortProducts(this.value)">
    <option value="newest">Sort by: Newest</option>
    <option value="price-low">Price: Low to High</option>
    <option value="price-high">Price: High to Low</option>
  </select>
</div>

<div class="container mb-5">
  <div class="row">

    <!-- ── SIDEBAR ── -->
    <div class="col-md-3">

      <!-- Categories -->
      <div class="sidebar-card">
        <h5>Categories</h5>
        <a href="/men" class="active">All Men's</a>
        {{#each subCategories}}
          <a href="/men?sub={{this._id}}">{{this.name}}</a>
        {{/each}}
      </div>

      <!-- Price Range -->
      <div class="sidebar-card">
        <h5>Price Range</h5>
        <div class="price-range">
          <input type="number" placeholder="Min" id="minPrice" />
          <span>—</span>
          <input type="number" placeholder="Max" id="maxPrice" />
        </div>
        <button class="btn btn-primary btn-sm btn-block mt-3"
                onclick="filterByPrice()">Apply</button>
      </div>

      <!-- Sizes -->
      <div class="sidebar-card">
        <h5>Sizes</h5>
        <div class="d-flex flex-wrap gap-2">
          {{#each (range 6 12)}}
            <span class="badge badge-light p-2"
                  style="cursor:pointer;border:1px solid #dee2e6;font-size:13px;">
              {{this}}
            </span>
          {{/each}}
        </div>
      </div>

    </div>

    <!-- ── PRODUCTS GRID ── -->
    <div class="col-md-9">
      {{#if products.length}}
        <div class="row" id="productsGrid">
          {{#each products}}
          <div class="col-md-4 col-sm-6 mb-4">
            <div class="card product-card h-100">
              {{!-- <div class="product-img-wrap">
                <img src="{{this.mainImage}}"
                     class="product-img"
                     alt="{{this.name}}"
                     onerror="this.src='/images/default-shoe.jpg'" />
              </div> --}}
              <a href="/products/{{this._id}}">
  <div class="product-img-wrap">
    <img src="{{this.mainImage}}" class="product-img" alt="{{this.name}}"
         onerror="this.src='/images/default-shoe.jpg'" />
  </div>
</a>
              <div class="card-body">
                <p class="product-brand mb-1">{{this.brand}}</p>
                <h5 class="card-title">{{this.name}}</h5>
                <p class="product-price">₹{{this.price}}</p>
                <div class="d-flex gap-2">
                  <a href="/products/{{this._id}}" class="btn btn-outline-primary btn-sm flex-fill">
                    View
                  </a>
                  <form action="/cart/add/{{this._id}}" method="POST" class="flex-fill">
                    <button type="submit" class="btn btn-primary btn-sm btn-block">
                      <i class="fas fa-cart-plus"></i> Add
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
          {{/each}}
        </div>
      {{else}}
        <div class="empty-state">
          <i class="fas fa-shoe-prints"></i>
          <h4>No products found in Men's Collection</h4>
          <p class="text-muted">Check back soon for new arrivals!</p>
          <a href="/products" class="btn btn-primary mt-3">View All Products</a>
        </div>
      {{/if}}
    </div>

  </div>
</div>

<script>
  function sortProducts(value) {
    const grid = document.getElementById('productsGrid');
    const cards = Array.from(grid.querySelectorAll('.col-md-4'));

    cards.sort((a, b) => {
      const priceA = parseInt(a.querySelector('.product-price').textContent.replace('₹','').replace(',',''));
      const priceB = parseInt(b.querySelector('.product-price').textContent.replace('₹','').replace(',',''));
      if (value === 'price-low') return priceA - priceB;
      if (value === 'price-high') return priceB - priceA;
      return 0;
    });

    cards.forEach(card => grid.appendChild(card));
  }

  function filterByPrice() {
    const min = parseInt(document.getElementById('minPrice').value) || 0;
    const max = parseInt(document.getElementById('maxPrice').value) || Infinity;
    const cards = document.querySelectorAll('#productsGrid .col-md-4');

    cards.forEach(card => {
      const price = parseInt(card.querySelector('.product-price').textContent.replace('₹','').replace(',',''));
      card.style.display = (price >= min && price <= max) ? '' : 'none';
    });
  }
</script>
