<link rel="stylesheet" href="/style/admin/admin.css">
<div class="info-section">
  <h2>Edit Profile</h2>
  <form action="/profile" method="POST" class="profile-form">
    <div class="form-group">
      <label>Full Name</label>
      <input type="text" name="name" value="{{user.name}}" class="form-input" />
    </div>
    
    <div class="form-group">
      <label>Phone Number</label>
      <input type="text" name="phone" value="{{user.phone}}" class="form-input" />
    </div>
    
    <div class="form-group">
      <label>Email Address</label>
      <input type="email" name="email" value="{{user.email}}" class="form-input" readonly />
      <small class="form-note">Contact support to change email</small>
    </div>
    
    <div class="form-group">
      <label>Street Address</label>
      <input type="text" name="address[street]" value="{{user.address.street}}" class="form-input" />
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <label>City</label>
        <input type="text" name="address[city]" value="{{user.address.city}}" class="form-input" />
      </div>
      <div class="form-group">
        <label>State/Province</label>
        <input type="text" name="address[state]" value="{{user.address.state}}" class="form-input" />
      </div>
    </div>
    
    <div class="form-row">
      <div class="form-group">
        <label>ZIP/Postal Code</label>
        <input type="text" name="address[zip]" value="{{user.address.zip}}" class="form-input" />
      </div>
      <div class="form-group">
        <label>Country</label>
        <select name="address[country]" class="form-input">
          <option value="{{user.address.country}}" selected>{{user.address.country}}</option>
          <option value="United States">United States</option>
          <option value="Canada">Canada</option>
          <option value="UK">United Kingdom</option>
          <option value="UK">India</option>
         
        </select>
      </div>
    </div>
    
    <div class="form-actions">
      <button type="submit" class="save-btn">Save Changes</button>
      <a href="/profile" class="cancel-btn">Cancel</a>
    </div>
  </form>
</div>

