
<h2 class="text-center my-4">Manage Addresses</h2>

<div class="text-center mb-4">
  <a href="/profile/addAddress" class="btn btn-primary px-4 py-2">
    <i class="fas fa-plus-circle"></i> Add New Address
  </a>
</div>

<div class="container">
  {{#if addresses.length}}
    <div class="d-flex flex-wrap justify-content-center gap-4">
      {{#each addresses}}
        <div class="card shadow-sm border-0 rounded-3" style="width: 320px;">
          <div class="card-body">
            <h5 class="card-title text-primary">{{name}}</h5>
            <p class="card-text mb-1">
              {{streetAddress}}<br>
              {{#if landmark}}<strong>Landmark:</strong> {{landmark}}<br>{{/if}}
              {{city}}, {{state}} - {{zip}}<br>
              {{country}}
            </p>
            <p class="mb-2"><strong>Phone:</strong> {{phone}}</p>

            <div class="d-flex justify-content-between mt-3">
              <a href="/profile/EditeAddress/{{this._id}}/edit" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-edit"></i> Edit
              </a>

              <a href="/profile/{{this._id}}/delete"
                 class="btn btn-outline-danger btn-sm"
                 onclick="return confirm('Are you sure you want to delete this address?')">
                <i class="fas fa-trash"></i> Delete
              </a>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="alert alert-info text-center mt-4">
      No addresses found. 
      <a href="/profile/addAddress" class="alert-link">Add one</a>
    </div>
  {{/if}}
</div>

