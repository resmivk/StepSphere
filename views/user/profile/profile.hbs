
<style>
  /* Scoped styles: .profile-component prefix ensures no conflicts with your site */
  .profile-component .profile-container {
    max-width: 1100px;
    width: 100%;
    margin: 2rem auto; /* Centers the card on your page */
    background: #ffffff;
    border-radius: 32px;
    box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }

  .profile-component .profile-split {
    display: flex;
    flex-wrap: wrap;
  }

  /* LEFT COLUMN */
  .profile-component .profile-left {
    flex: 1.2;
    background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
    padding: 2.2rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-right: 1px solid #e9eef3;
  }

  .profile-component .profile-avatar {
    position: relative;
    width: 140px;
    height: 140px;
    margin-bottom: 1.5rem;
  }

  .profile-component .avatar-circle {
    width: 100%;
    height: 100%;
    background: linear-gradient(145deg, #2dd4bf, #0f766e);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 12px 20px -8px rgba(15, 118, 110, 0.3);
  }

  .profile-component .avatar-circle i { font-size: 3.2rem; color: white; }
  .profile-component .avatar-circle img { width: 100%; height: 100%; object-fit: cover; }

  .profile-component .camera-icon {
    position: absolute;
    bottom: 6px; right: 8px;
    background: white; width: 36px; height: 36px;
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15); cursor: pointer; border: 2px solid #fff;
  }

  .profile-component .profile-name-large { font-size: 1.8rem; font-weight: 700; color: #0f172a; margin: 0.5rem 0 0.25rem; }
  .profile-component .profile-email-large { font-size: 0.95rem; color: #475569; background: #f1f5f9; padding: 0.3rem 1rem; border-radius: 40px; }

  /* RIGHT COLUMN */
  .profile-component .profile-right { flex: 1.8; padding: 2rem 2.2rem; background: white; }
  .profile-component .info-section-title { font-size: 1.5rem; font-weight: 600; color: #0f172a; margin-bottom: 1.4rem; border-left: 5px solid #14b8a6; padding-left: 1rem; }
  .profile-component .info-grid { display: flex; flex-direction: column; gap: 1.2rem; margin-bottom: 2rem; }
  .profile-component .info-item { display: flex; align-items: center; border-bottom: 1px solid #eef2f6; padding-bottom: 0.75rem; }
  .profile-component .info-label { width: 160px; font-weight: 600; color: #334155; font-size: 0.9rem; }
  .profile-component .info-value { flex: 1; color: #1e293b; font-weight: 500; font-size: 1rem; }

  .profile-component .edit-btn {
    display: inline-flex; align-items: center; gap: 10px; background: #0f172a; color: white;
    padding: 0.8rem 1.6rem; border-radius: 60px; text-decoration: none; font-weight: 600; transition: 0.2s;
  }
  .profile-component .edit-btn:hover { background: #2dd4bf; color: #0f172a; }

  /* Responsive */
  @media (max-width: 780px) {
    .profile-component .profile-split { flex-direction: column; }
    .profile-component .profile-left { border-right: none; border-bottom: 1px solid #e9eef3; }
    .profile-component .info-item { flex-direction: column; align-items: flex-start; gap: 4px; }
  }
</style>

<div class="profile-component">
  <div class="profile-container">
    <div class="profile-split">
      <div class="profile-left">
        <div class="profile-avatar">
          <div class="avatar-circle" id="avatarPreview">
            <i class="fas fa-user-circle" id="avatarIcon"></i>
            <img id="avatarImg" src="" alt="profile" style="display: none;">
          </div>
          <input type="file" id="secureFileInput" accept="image/*" style="display: none;">
          <span class="camera-icon" id="cameraTrigger"><i class="fas fa-camera"></i></span>
        </div>
        <div class="profile-name-large"></div>
        <div class="profile-email-large"></div>
      </div>

      <div class="profile-right">
        <div class="info-section-title"><i class="fas fa-id-card" style="margin-right: 10px; color: #14b8a6;"></i> Personal Information</div>
        <dl class="info-grid">
          <div class="info-item">
            <dt class="info-label"><i class="fas fa-user" style="width: 20px;"></i> Full Name:</dt>
            <dd class="info-value"></dd>
          </div>
          <div class="info-item">
            <dt class="info-label"><i class="fas fa-mobile-alt" style="width: 20px;"></i> Mobile:</dt>
            <dd class="info-value"></dd>
          </div>
          <div class="info-item">
            <dt class="info-label"><i class="fas fa-envelope" style="width: 20px;"></i> Email:</dt>
            <dd class="info-value"></dd>
          </div>
        </dl>
        <a href="/profile/Editprofile" class="edit-btn"><i class="fas fa-edit"></i> Edit Profile</a>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const cameraBtn = document.getElementById('cameraTrigger');
    const fileInput = document.getElementById('secureFileInput');
    const avatarIcon = document.getElementById('avatarIcon');
    const avatarImg = document.getElementById('avatarImg');
    
    cameraBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (ev) => {
          avatarIcon.style.display = 'none';
          avatarImg.src = ev.target.result;
          avatarImg.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    });
  })();
</script>
