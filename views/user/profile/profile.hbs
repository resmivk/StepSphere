<div class="profile-header">
  <div class="profile-avatar">
    {{#if user.avatar}}
      <img src="{{user.avatar}}" alt="{{user.name}}" style="width:100%; height:100%; border-radius:50%; object-fit:cover;">
    {{else}}
      <i class="fas fa-user"></i>
    {{/if}}
    <span class="camera-icon" aria-label="Change photo"><i class="fas fa-camera"></i></span>
  </div>
  <div class="profile-info">
    <h2>{{user.name}}</h2>
    <p>{{user.email}}</p>
    {{#if user.joinDate}}
      <p>Member since {{formatDate user.joinDate}}</p>
    {{/if}}
  </div>
</div>

<div class="info-section">
  <h3>Personal Information</h3>
  <div class="info-item">
    <span>Full Name:</span>
    <span>{{user.name}}</span>
  </div>
  {{#if user.phone}}
  <div class="info-item">
    <span>Mobile Number:</span>
    <span>{{user.phone}}</span>
  </div>
  {{/if}}
  <div class="info-item">
    <span>Email ID:</span>
    <span>{{user.email}}</span>
  </div>
  <a href="/profile/Editprofile" class="edit-btn"><i class="fas fa-edit"></i> Edit Profile</a>
</div>
