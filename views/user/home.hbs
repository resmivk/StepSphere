            padding: 20px;
            text-align: center;
        }
        
        /* Products */
        .product-card {
            margin-bottom: 30px;
            transition: transform 0.3s;
            border: none;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }
        
        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
        }
        
        .product-img {
            height: 250px;
            object-fit: cover;
            width: 100%;
            transition: transform 0.5s;
