    <div class="text-center mb-4">
      <h2 class="section-title">Our Trusted Partners</h2>
      <p class="lead text-muted mt-3">Collaborating with the best in the industry</p>
    </div>
    <div class="row justify-content-center align-items-center">
      {{#each partners}}
      <div class="col-6 col-sm-4 col-md-2 mb-4 text-center">
        <img src="{{this.logo}}" class="img-fluid partner-logo"
