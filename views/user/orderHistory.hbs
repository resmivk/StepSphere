<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Orders – StepSphere</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"/>
  <style>
    body { background: #f8f9fa; font-family: 'Segoe UI', sans-serif; }
    .page-header { background: #fff; padding: 28px 0; border-bottom: 1px solid #eee; margin-bottom: 32px; }
    .order-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-bottom: 20px; overflow: hidden; }
    .order-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 1px solid #f0f0f0; flex-wrap: wrap; gap: 10px; }
    .order-id { font-weight: 700; color: #00b4d8; font-size: 0.9rem; }
    .order-date { color: #888; font-size: 0.85rem; }
    .order-body { padding: 16px 24px; }
    .order-item { display: flex; align-items: center; gap: 14px; padding: 10px 0; border-bottom: 1px solid #f8f8f8; }
    .order-item:last-child { border-bottom: none; }
    .order-item img { width: 55px; height: 55px; object-fit: cover; border-radius: 8px; border: 1px solid #eee; }
    .order-item-name { font-weight: 600; font-size: 0.9rem; }
    .order-item-meta { color: #999; font-size: 0.8rem; }
    .order-footer { display: flex; justify-content: space-between; align-items: center; padding: 14px 24px; background: #fafafa; border-top: 1px solid #f0f0f0; flex-wrap: wrap; gap: 10px; }
    .status-badge { padding: 5px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; text-transform: capitalize; }
    .status-placed { background: #e3f2fd; color: #1565c0; }
    .status-processing { background: #fff3e0; color: #e65100; }
    .status-shipped { background: #e8f5e9; color: #2e7d32; }
    .status-delivered { background: #e8f5e9; color: #1b5e20; }
    .status-cancelled { background: #ffebee; color: #c62828; }
    .btn-cancel { background: transparent; border: 1px solid #dc3545; color: #dc3545; border-radius: 6px; padding: 6px 16px; font-size: 0.85rem; cursor: pointer; transition: all 0.2s; }
    .btn-cancel:hover { background: #dc3545; color: #fff; }
    .empty-state { text-align: center; padding: 60px 20px; }
    .empty-state i { font-size: 3rem; color: #ddd; margin-bottom: 16px; }

    /* Cancel Modal */
    .modal-header { border-bottom: 1px solid #eee; }
    .btn-confirm-cancel { background: #dc3545; color: #fff; border: none; border-radius: 6px; padding: 10px 24px; font-weight: 600; }
  </style>
</head>
<body>

{{> navbar}}

<div class="page-header">
  <div class="container">
    <h2 class="font-weight-bold mb-0">My Orders</h2>
  </div>
</div>

<div class="container pb-5">

  {{#if orders.length}}

    {{#each orders}}
    <div class="order-card">
      <div class="order-header">
        <div>
          <div class="order-id">Order #{{this._id}}</div>
          <div class="order-date"><i class="far fa-calendar-alt mr-1"></i>{{this.createdAt}}</div>
        </div>
        <span class="status-badge status-{{this.orderStatus}}">
          {{this.orderStatus}}
        </span>
      </div>

      <div class="order-body">
        {{#each this.items}}
        <div class="order-item">
          <img src="{{#if this.image}}/uploads/{{this.image}}{{else}}/images/default-shoe.jpg{{/if}}"
               alt="{{this.name}}"
               onerror="this.src='/images/default-shoe.jpg'"/>
          <div class="flex-grow-1">
            <div class="order-item-name">{{this.name}}</div>
            <div class="order-item-meta">Qty: {{this.quantity}} {{#if this.size}}| Size: {{this.size}}{{/if}}</div>
          </div>
          <div class="font-weight-600">₹{{this.price}}</div>
        </div>
        {{/each}}
      </div>

      <div class="order-footer">
        <div>
          <span class="text-muted mr-3">Total:</span>
          <span class="font-weight-700 text-dark">₹{{this.totalAmount}}</span>
          <span class="ml-3 text-muted" style="font-size:0.85rem;">via <span class="text-capitalize">{{this.paymentMethod}}</span></span>
        </div>
        {{#unless (or (eq this.orderStatus 'shipped') (eq this.orderStatus 'delivered') (eq this.orderStatus 'cancelled'))}}
        <button class="btn-cancel" onclick="openCancelModal('{{this._id}}')">
          <i class="fas fa-times mr-1"></i> Cancel Order
        </button>
        {{/unless}}
      </div>
    </div>
    {{/each}}

  {{else}}
    <div class="empty-state">
      <i class="fas fa-box-open"></i>
      <h4>No orders yet</h4>
      <p class="text-muted">You haven't placed any orders. Start shopping!</p>
      <a href="/products" class="btn btn-primary mt-2">Shop Now</a>
    </div>
  {{/if}}

</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title font-weight-bold">Cancel Order</h5>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>
      <div class="modal-body">
        <label class="font-weight-600 mb-2">Reason for cancellation</label>
        <textarea id="cancelReason" class="form-control" rows="3" placeholder="Please tell us why you want to cancel..."></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-dismiss="modal">Keep Order</button>
        <button class="btn-confirm-cancel" onclick="confirmCancel()">Yes, Cancel</button>
      </div>
    </div>
  </div>
</div>

{{> footer}}

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<script>
  let selectedOrderId = null;

  function openCancelModal(orderId) {
    selectedOrderId = orderId;
    $('#cancelModal').modal('show');
  }

  async function confirmCancel() {
    const reason = document.getElementById('cancelReason').value.trim();
    if (!reason) return alert('Please provide a reason.');

    const res = await fetch(`/order/cancel/${selectedOrderId}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason })
    });

    const data = await res.json();
    if (data.success) {
      $('#cancelModal').modal('hide');
      location.reload();
    } else {
      alert(data.message || 'Failed to cancel order.');
    }
  }
</script>
</body>
</html>
