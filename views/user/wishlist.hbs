

<div class="wishlist-page-wrapper">
  <div class="wishlist-container">
    <!-- Header Section -->
    <div class="wishlist-header">
      <div class="header-title-group">
        <h2 class="page-title">
          <i class="fas fa-heart heart-icon-accent"></i> My Wishlist
        </h2>
        <span class="item-count-badge" id="wishlist-count-badge">
          {{items.length}} {{#if (eq items.length 1)}}item{{else}}items{{/if}}
        </span>
      </div>
      {{#if items.length}}
        <div class="header-actions">
          <a href="/products" class="btn-secondary-link">
            <i class="fas fa-search"></i> Discover More
          </a>
        </div>
      {{/if}}
    </div>

    <!-- Main Content -->
    {{#if items.length}}
      <div class="wishlist-grid" id="wishlist-grid">
        {{#each items}}
          <div class="wish-card" id="wish-card-{{productId._id}}">
            <button class="remove-btn" onclick="removeFromWishlist('{{productId._id}}')" title="Remove from wishlist">
              <i class="fas fa-times"></i>
            </button>

            <a href="/products/{{productId._id}}" class="wish-card-link">
              <div class="wish-img-wrap">
                <img src="{{productId.displayImage}}" alt="{{productId.name}}" loading="lazy" onerror="this.src='/uploads/default-shoe.jpg'" />
              </div>
              <div class="wish-info">
                <h3 class="wish-name">{{productId.name}}</h3>
                <div class="wish-price-row">
                  <span class="wish-price">₹{{productId.price}}</span>
                  {{#if productId.oldPrice}}
                    <span class="wish-old-price">₹{{productId.oldPrice}}</span>
                  {{/if}}
                </div>
              </div>
            </a>

            <div class="wish-actions">
              <button class="btn-cart" onclick="moveToCart('{{productId._id}}')">
                <i class="fas fa-shopping-bag"></i> Move to Cart
              </button>
            </div>
          </div>
        {{/each}}
      </div>
    {{/if}}

    <!-- Empty State (Hidden when items exist, shown when empty) -->
    <div class="empty-wishlist-card {{#if items.length}}d-none{{/if}}" id="empty-wishlist-view">
      <div class="empty-icon-pulse-wrapper">
        <div class="pulse-ring"></div>
        <div class="empty-icon-box">
          <i class="fas fa-heart"></i>
        </div>
      </div>
      <h3 class="empty-title">Your Wishlist is Empty</h3>
      <p class="empty-subtitle">
        Explore our latest footwear collections and save your favorite styles to review or purchase anytime.
      </p>
      <a href="/products" class="btn-continue-shopping">
        <span>Explore Collection</span>
        <i class="fas fa-arrow-right"></i>
      </a>
    </div>
  </div>
</div>

<!-- Toast Container for Notifications -->
<div id="toast-container" class="toast-container"></div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

  .wishlist-page-wrapper {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    background: #f8fafc;
    min-height: 75vh;
    padding: 40px 20px 80px;
    color: #0f172a;
  }

  .wishlist-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header Section */
  .wishlist-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e2e8f0;
  }

  .header-title-group {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .page-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .heart-icon-accent {
    color: #ef4444;
    font-size: 1.5rem;
  }

  .item-count-badge {
    background: #eff6ff;
    color: #2563eb;
    border: 1px solid #bfdbfe;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 4px 14px;
    border-radius: 9999px;
  }

  .btn-secondary-link {
    color: #475569;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s;
  }

  .btn-secondary-link:hover {
    color: #2563eb;
  }

  /* Grid Layout */
  .wishlist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }

  /* Wish Card */
  .wish-card {
    position: relative;
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #f1f5f9;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
  }

  .wish-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
    border-color: #cbd5e1;
  }

  .wish-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  /* Remove Button */
  .remove-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 50%;
    width: 34px;
    height: 34px;
    cursor: pointer;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: all 0.2s ease;
  }

  .remove-btn:hover {
    background: #ef4444;
    color: #ffffff;
    transform: rotate(90deg);
  }

  /* Image Wrap */
  .wish-img-wrap {
    height: 220px;
    overflow: hidden;
    background: #f8fafc;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .wish-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wish-card:hover .wish-img-wrap img {
    transform: scale(1.07);
  }

  /* Info */
  .wish-info {
    padding: 16px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .wish-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: #1e293b;
    margin: 0 0 8px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .wish-price-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 4px;
  }

  .wish-price {
    color: #2563eb;
    font-weight: 800;
    font-size: 1.15rem;
  }

  .wish-old-price {
    color: #94a3b8;
    text-decoration: line-through;
    font-size: 0.85rem;
  }

  /* Actions */
  .wish-actions {
    padding: 0 16px 16px;
  }

  .btn-cart {
    width: 100%;
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    color: #ffffff;
    border: none;
    border-radius: 12px;
    padding: 11px;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
    transition: all 0.2s ease;
  }

  .btn-cart:hover {
    background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
    transform: translateY(-1px);
  }

  /* Empty State Card */
  .empty-wishlist-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #f1f5f9;
    box-shadow: 0 12px 40px rgba(15, 23, 42, 0.04);
    padding: 80px 30px;
    text-align: center;
    max-width: 600px;
    margin: 40px auto;
  }

  .empty-icon-pulse-wrapper {
    position: relative;
    width: 90px;
    height: 90px;
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pulse-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: rgba(239, 68, 68, 0.12);
    animation: pulseHeart 2s infinite cubic-bezier(0.4, 0, 0.6, 1);
  }

  .empty-icon-box {
    position: relative;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
    color: #ef4444;
    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(239, 68, 68, 0.15);
  }

  @keyframes pulseHeart {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.2); opacity: 0; }
    100% { transform: scale(0.95); opacity: 0; }
  }

  .empty-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .empty-subtitle {
    color: #64748b;
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 440px;
    margin: 0 auto 30px;
  }

  .btn-continue-shopping {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    color: #ffffff;
    padding: 14px 34px;
    border-radius: 9999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.28);
    transition: all 0.3s ease;
  }

  .btn-continue-shopping:hover {
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(37, 99, 235, 0.38);
  }

  .d-none {
    display: none !important;
  }

  /* Toast Notification */
  .toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .custom-toast {
    background: #0f172a;
    color: #ffffff;
    padding: 12px 20px;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    gap: 10px;
    animation: slideInRight 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .custom-toast.success { border-left: 4px solid #10b981; }
  .custom-toast.error { border-left: 4px solid #ef4444; }

  @keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
</style>

<script>
  function showToast(message, type = 'success') {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    toast.className = `custom-toast ${type}`;
    toast.innerHTML = `
      <i class="fas ${type === 'success' ? 'fa-check-circle text-success' : 'fa-exclamation-circle text-danger'}"></i>
      <span>${message}</span>
    `;
    container.appendChild(toast);
    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transition = 'opacity 0.3s ease';
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  function updateItemCount() {
    const grid = document.getElementById('wishlist-grid');
    const remainingCards = grid ? grid.getElementsByClassName('wish-card').length : 0;
    const badge = document.getElementById('wishlist-count-badge');
    
    if (badge) {
      badge.textContent = `${remainingCards} ${remainingCards === 1 ? 'item' : 'items'}`;
    }

    if (remainingCards === 0) {
      if (grid) grid.remove();
      const emptyView = document.getElementById('empty-wishlist-view');
      if (emptyView) emptyView.classList.remove('d-none');
    }
  }

  async function removeFromWishlist(productId) {
    try {
      const res = await fetch(`/wishlist/remove/${productId}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        const card = document.getElementById(`wish-card-${productId}`);
        if (card) {
          card.style.transform = 'scale(0.8)';
          card.style.opacity = '0';
          card.style.transition = 'all 0.3s ease';
          setTimeout(() => {
            card.remove();
            updateItemCount();
          }, 300);
        }
        showToast(data.message || 'Item removed from wishlist');
      } else {
        showToast(data.message || 'Failed to remove item', 'error');
      }
    } catch (err) {
      showToast('Something went wrong', 'error');
    }
  }

  async function moveToCart(productId) {
    try {
      const res = await fetch(`/wishlist/move-to-cart/${productId}`, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        const card = document.getElementById(`wish-card-${productId}`);
        if (card) {
          card.style.transform = 'scale(0.8)';
          card.style.opacity = '0';
          card.style.transition = 'all 0.3s ease';
          setTimeout(() => {
            card.remove();
            updateItemCount();
          }, 300);
        }
        showToast(data.message || 'Moved to cart successfully!');
      } else {
        showToast(data.message || 'Failed to move item to cart', 'error');
      }
    } catch (err) {
      showToast('Something went wrong', 'error');
    }
  }
</script>

