
<style>
  :root {
    --blue:       #2874f0;
    --blue-dark:  #1a5dc8;
    --blue-light: #e8f0fe;
    --yellow:     #fb8c00;
    --green:      #388e3c;
    --red:        #d32f2f;
    --gray-bg:    #f1f3f6;
    --white:      #ffffff;
    --text:       #212121;
    --muted:      #878787;
    --border:     #e0e0e0;
    --shadow:     0 2px 8px rgba(0,0,0,0.10);
  }

  body { background: var(--gray-bg) !important; }

  .cart-page {
    max-width: 1200px;
    margin: 28px auto;
    padding: 0 16px;
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 16px;
    align-items: start;
  }

  .cart-card {
    background: var(--white);
    border-radius: 4px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .cart-header {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 10px;
  }
  .cart-header h2 { font-size: 18px; font-weight: 800; color: var(--text); }
  .cart-count {
    background: var(--blue-light); color: var(--blue);
    font-size: 13px; font-weight: 700;
    padding: 2px 10px; border-radius: 20px;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 16px; padding: 20px;
    border-bottom: 1px solid var(--border);
    transition: background .15s; align-items: start;
  }
  .cart-item:last-child { border-bottom: none; }
  .cart-item:hover { background: #fafbff; }

  .item-img-wrap {
    width: 110px; height: 110px;
    border: 1px solid var(--border); border-radius: 4px;
    overflow: hidden; display: flex;
    align-items: center; justify-content: center;
    background: #f9f9f9;
  }
  .item-img-wrap img { width: 100%; height: 100%; object-fit: cover; }

  .item-info { display: flex; flex-direction: column; gap: 6px; }
  .item-name  { font-size: 16px; font-weight: 700; color: var(--text); }
  .item-brand { font-size: 13px; color: var(--muted); font-weight: 600; }
  .item-price { font-size: 20px; font-weight: 800; color: var(--text); margin-top: 4px; }
  .item-price span { font-size: 13px; color: var(--green); font-weight: 700; margin-left: 8px; }

  .qty-row { display: flex; align-items: center; margin-top: 10px; }
  .qty-btn {
    width: 32px; height: 32px;
    border: 1px solid var(--border); background: var(--white);
    color: var(--blue); font-size: 18px; font-weight: 700;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    text-decoration: none; transition: background .15s, color .15s; border-radius: 2px;
  }
  .qty-btn:hover { background: var(--blue); color: var(--white); }
  .qty-num {
    min-width: 42px; height: 32px;
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; font-weight: 700;
  }

  .item-actions { display: flex; flex-direction: column; align-items: flex-end; }
  .btn-remove {
    display: inline-flex; align-items: center; gap: 5px;
    color: var(--red); font-size: 13px; font-weight: 700;
    text-decoration: none; padding: 5px 10px;
    border: 1px solid var(--red); border-radius: 3px;
    transition: background .15s, color .15s;
  }
  .btn-remove:hover { background: var(--red); color: var(--white); }

  .empty-cart { padding: 60px 20px; text-align: center; }
  .empty-icon  { font-size: 64px; margin-bottom: 16px; }
  .empty-cart h3 { font-size: 22px; font-weight: 800; margin-bottom: 8px; }
  .empty-cart p  { color: var(--muted); margin-bottom: 20px; font-size: 15px; }
  .btn-shop {
    display: inline-block; background: var(--blue); color: var(--white);
    padding: 12px 32px; border-radius: 3px;
    font-weight: 800; font-size: 15px; text-decoration: none;
  }
  .btn-shop:hover { background: var(--blue-dark); }

  .summary-card {
    background: var(--white); border-radius: 4px;
    box-shadow: var(--shadow); overflow: hidden;
    position: sticky; top: 80px;
  }
  .summary-header {
    padding: 14px 20px; border-bottom: 1px solid var(--border);
    font-size: 13px; font-weight: 700; color: var(--muted);
    letter-spacing: 1px; text-transform: uppercase;
  }
  .summary-body { padding: 0 20px; }
  .summary-row {
    display: flex; justify-content: space-between;
    padding: 14px 0; border-bottom: 1px solid var(--border); font-size: 15px;
  }
  .summary-row:last-child { border-bottom: none; }
  .summary-row .label { color: var(--text); font-weight: 600; }
  .summary-row .val   { font-weight: 700; }
  .summary-row.total .label,
  .summary-row.total .val { font-weight: 800; font-size: 17px; }

  .summary-savings {
    background: #e8f5e9; color: var(--green);
    font-size: 14px; font-weight: 700;
    padding: 10px 20px; border-top: 1px solid #c8e6c9; text-align: center;
  }
  .btn-order {
    display: block; width: calc(100% - 40px); margin: 18px 20px;
    background: var(--yellow); color: var(--white);
    border: none; border-radius: 3px; padding: 14px;
    font-size: 16px; font-weight: 800; text-align: center;
    text-decoration: none; transition: background .2s, transform .1s;
    box-shadow: 0 2px 8px rgba(251,140,0,.35);
  }
  .btn-order:hover { background: #e67e00; transform: translateY(-1px); }

  .secure-badge {
    display: flex; align-items: center; justify-content: center;
    gap: 6px; color: var(--muted); font-size: 12px; font-weight: 600;
    padding: 0 20px 16px;
  }

  @media (max-width: 768px) {
    .cart-page { grid-template-columns: 1fr; }
    .summary-card { position: static; }
    .cart-item { grid-template-columns: 80px 1fr; }
    .item-actions { grid-column: 1 / -1; }
  }
</style>

<div class="cart-page">

  <!-- LEFT: CART ITEMS -->
  <div class="cart-card">
    {{#if userCart.length}}

      <div class="cart-header">
        <h2>🛒 Shopping Cart</h2>
        <span class="cart-count">{{userCart.length}} item(s)</span>
      </div>

      {{#each userCart}}
        <div class="cart-item">

          <div class="item-img-wrap">
            <img src="/uploads/{{this.productId.images.[0]}}"
                 alt="{{this.productId.name}}"
                 onerror="this.src='/uploads/default-shoe.jpg'" />
          </div>

          <div class="item-info">
            <div class="item-name">{{this.productId.name}}</div>
            <div class="item-brand">{{this.productId.brand}}</div>
            <div class="item-price">
              ₹ {{this.productId.price}}
              <span>In Stock ✓</span>
            </div>
            <div class="qty-row">
              <a href="/cart/update/{{this.productId._id}}?action=dec" class="qty-btn">−</a>
              <span class="qty-num">{{this.quantity}}</span>
              <a href="/cart/update/{{this.productId._id}}?action=inc" class="qty-btn">+</a>
            </div>
          </div>

          <div class="item-actions">
            <a href="/cart/remove/{{this.productId._id}}" class="btn-remove">🗑 Remove</a>
          </div>

        </div>
      {{/each}}

    {{else}}
      <div class="empty-cart">
        <div class="empty-icon">🛒</div>
        <h3>Your cart is empty!</h3>
        <p>Looks like you haven't added anything yet.</p>
        <a href="/products" class="btn-shop">Start Shopping</a>
      </div>
    {{/if}}
  </div>

  <!-- RIGHT: SUMMARY -->
  {{#if userCart.length}}
  <div class="summary-card">
    <div class="summary-header">Price Details</div>
    <div class="summary-body">
      <div class="summary-row">
        <span class="label">Price ({{userCart.length}} items)</span>
        <span class="val">₹ {{subtotal}}</span>
      </div>
      <div class="summary-row">
        <span class="label">Delivery Charges</span>
        <span class="val" style="color:var(--green)">FREE</span>
      </div>
      <div class="summary-row">
        <span class="label">Platform Fee</span>
        <span class="val">₹ 20</span>
      </div>
      <div class="summary-row total">
        <span class="label">Total Amount</span>
        <span class="val">₹ {{totalAmount}}</span>
      </div>
    </div>
    <div class="summary-savings">🎉 Your order is eligible for FREE Delivery!</div>
    <a href="/checKout" class="btn-order">PLACE ORDER →</a>
    <div class="secure-badge">🔒 Safe and Secure Payments</div>
  </div>
  {{/if}}

</div>
